PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/faaro
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-different-long-random-secret
CLIENT_URL=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
STRIPE_SECRET_KEY=sk_test_replace_me
# Local delivery: use the signing secret printed by `stripe listen`.
# Deployed delivery: use the signing secret of that exact registered endpoint.
# These secrets are different from each other and from STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_KEY_SECRET=replace_me
EMAIL_HOST=replace_me
EMAIL_PORT=587
EMAIL_USER=replace_me
EMAIL_PASS=replace_me
# Optional SMS provider credentials:
SMS_USER=
SMS_PASS=
